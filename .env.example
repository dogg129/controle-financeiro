# Copie para ".env" e defina uma senha própria para o banco.
# O arquivo .env não deve ser versionado nem incluído na imagem.

# Nome local para a imagem; não exige conta no Docker Hub.
DOCKERHUB_USER=local

# Credenciais do PostgreSQL
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro_user
POSTGRES_PASSWORD=defina_uma_senha_forte
